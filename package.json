{
  "name": "fps-shooter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FPS Web 3D (Mata-Mata) - cliente Babylon.js",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "start": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babylonjs/core": "^7.0.0",
    "@babylonjs/loaders": "^7.54.3",
    "@babylonjs/materials": "^7.54.3",
    "bcryptjs": "^3.0.3",
    "colyseus": "^0.15.57",
    "colyseus.js": "^0.15.28",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
