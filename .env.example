# Copie para .env (servidor) e/ou .env.local (cliente Vite).

# --- Cliente (Vite) ---
# URL do Web Service Colyseus no Render (HTTPS; o colyseus.js converte para wss://):
VITE_SERVER_URL=https://fps-shooter-api.onrender.com

# --- Servidor (Render Environment / .env local) ---
# URI do Postgres no Supabase (Project Settings → Database → Connection string → URI):
# Preferir "Session pooler" ou conexão Direct.
# DATABASE_URL=postgresql://postgres.xxxx:SUA_SENHA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#
# Segredo para assinar JWTs (no Render o Blueprint gera automaticamente):
# JWT_SECRET=troca-isto-por-um-segredo-longo
#
# Sem DATABASE_URL o servidor corre em modo convidado (só nome, sem contas).
